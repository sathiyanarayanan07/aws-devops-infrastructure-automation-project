pipeline {
    agent any

    stages {
        stage('checkout'){
            steps {
                checkout scm
            }
    }
    stage('Test') {
        steps {
            sh 'python3 --version'
            sh 'pip3 install -r app/requirements.txt'
            sh 'python3 -m pytest -v'

        }
    }
    
    stage('Docker Build'){
        steps {
            sh ' docker build -f docker/Dockerfile -t aws-devops-app:v1 .'
        }
    }
    }
}